# ==============================================================================
# RUNHUB / JUMP-IN — CONFIGURATION ENVIRONNEMENT (.env.example)
# ==============================================================================

# Environnement d'exécution : 'development' | 'production' | 'test'
NODE_ENV=development

# Port du serveur HTTP (défaut : 3000)
PORT=3000

# Origines CORS autorisées (séparées par une virgule)
# - En dev : peut être vide (autorise localhost, Expo Go, etc.)
# - En prod : https://runhub.app,https://admin.runhub.app
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Documentation Swagger OpenAPI (/docs)
# - En dev : activé automatiquement
# - En prod : désactivé par défaut. Définir à 'true' si besoin (ex: staging).
ENABLE_SWAGGER=true

# ==============================================================================
# BASE DE DONNÉES (PostgreSQL + PostGIS via Prisma)
# ==============================================================================
DATABASE_URL="postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# SÉCURITÉ & AUTHENTIFICATION JWT
# ==============================================================================
JWT_ACCESS_SECRET="changez_moi_en_production_cle_secrete_tres_longue_access"
JWT_REFRESH_SECRET="changez_moi_en_production_cle_secrete_tres_longue_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ==============================================================================
# AUTHENTIFICATION TIÈCES (OAuth Google & Apple)
# ==============================================================================
GOOGLE_CLIENT_ID="sample_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_WEB="sample_web_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="sample_ios_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_ANDROID="sample_android_id.apps.googleusercontent.com"
APPLE_CLIENT_ID="com.musadiagnesorganization.runhub"

# ==============================================================================
# STOCKAGE MÉDIAS (Cloudflare R2 / AWS S3)
# ==============================================================================
R2_ACCESS_KEY_ID="sample_r2_access_key"
R2_SECRET_ACCESS_KEY="sample_r2_secret_key"
R2_ENDPOINT="https://sample_account_id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="runhub-media"
R2_PUBLIC_URL="https://media.runhub.app"

# ==============================================================================
# SERVICES EXTERNES (Google Places / Géolocalisation)
# ==============================================================================
GOOGLE_MAPS_API_KEY="AIzaSySampleKey"

# ==============================================================================
# ENVOI D'E-MAILS (Codes de connexion OTP Resend)
# ==============================================================================
# Optionnel en dev (si absent, les codes OTP sont affichés directement dans la console)
RESEND_API_KEY="re_sample_api_key"
RESEND_FROM_EMAIL="RunHub <onboarding@resend.dev>"
