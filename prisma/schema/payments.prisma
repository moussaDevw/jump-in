model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  registrationId String          @map("registration_id") @db.Uuid
  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  userId         String          @map("user_id") @db.Uuid
  user           User            @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  amount         Int             @map("amount")
  fee            Int             @map("fee")
  currency       String          @default("XOF")
  status         PaymentStatus
  providerRef    String?         @map("provider_ref")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Idempotence des webhooks PSP : un même (provider, providerRef) ne peut être inséré 2 fois.
  // providerRef NULL autorisé en multiple (paiements PENDING avant retour PSP).
  @@unique([provider, providerRef])
  @@index([registrationId])
  @@index([userId])
  @@map("payments")
}
